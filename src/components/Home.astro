---
import Base from '../layouts/Base.astro';
import WaitlistForm from './WaitlistForm.astro';
import { t, prefix, type Lang } from '../lib/i18n';
import site from '../data/site.json';
import pricing from '../data/pricing.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const p = prefix(lang);
const iosHref = site.iosState === 'waitlist' ? '#notify' : site.appStoreUrl;
const iosLabel = site.iosState === 'live' ? s.hero.ctaIosLive : site.iosState === 'preorder' ? s.hero.ctaIosPreorder : s.hero.ctaIos;
const androidHref = site.androidState === 'live' && site.playUrl ? site.playUrl : `${p}/android/`;
const money = (v: string) => `$${v}`;
const days = Math.max(0, Math.ceil((Date.parse(site.ramadanStart) - Date.now()) / 864e5));
const icons: Record<string, string> = {
  habits: 'M5 12l4 4 10-10', screen: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm4 16h2',
  worship: 'M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z', mindful: 'M12 4c4 4 4 12 0 16M12 4c-4 4-4 12 0 16M4 12h16',
  together: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 20c0-3 2.5-5 5-5s5 2 5 5m-2-5c.8-.6 2-1 3-1 2.5 0 5 2 5 5',
  motivation: 'M12 2l2.4 5 5.6.8-4 3.9 1 5.5-5-2.7-5 2.7 1-5.5-4-3.9 5.6-.8Z',
};
---
<Base lang={lang} title={s.meta.title} description={s.meta.description} path="/">
  <section class="hero" aria-labelledby="h1">
    <canvas class="sparks" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{s.hero.eyebrow}</p>
        <h1 id="h1" class="strike">{s.hero.h1.map((w, i) => <span class="w" style={`--i:${i}`}>{w}</span>)}</h1>
        <p class="sub"><span data-only="faith">{s.hero.subFaith}</span><span data-only="general">{s.hero.subGeneral}</span></p>
        <div class="ctas">
          <a class="btn btn-ember" href={iosHref}>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.9-1.7 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.4-1-2.4-3.7ZM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.2-.6 2.9-1.4Z"/></svg>
            {iosLabel}
          </a>
          <a class="btn btn-ghost" href={androidHref}>{s.hero.ctaAndroid}</a>
        </div>
        <p class="hero-meta">
          <span class="chip"><b>{money(pricing.founders.yearly)}</b>&nbsp;{s.hero.perYear} · {s.hero.founders}</span>
          <span class="chip">{s.hero.launch}</span>
        </p>
        <div class="strip-wrap">
          <ol class="strip" aria-hidden="true">{Array.from({ length: 30 }, (_, i) => <li style={`--d:${i}`}></li>)}</ol>
          <span class="strip-label">{s.hero.strip}</span>
        </div>
      </div>
      <div class="hero-phone">
        <div class="phone" role="img" aria-label={s.phone.alt}>
          <div class="screen">
            <div class="notch" aria-hidden="true"></div>
            <div class="ph-top">
              <div>
                <span class="ph-day">{s.phone.today}</span>
                <span class="ph-date" data-only="faith">{s.phone.hijri}</span>
              </div>
              <div class="dial">
                <svg viewBox="0 0 44 44" aria-hidden="true">
                  <circle cx="22" cy="22" r="18" fill="none" stroke="var(--iron)" stroke-width="5" />
                  <circle class="dial-arc" cx="22" cy="22" r="18" fill="none" stroke="var(--ember)" stroke-width="5" stroke-linecap="round" pathLength="100" stroke-dasharray="64 100" transform="rotate(-90 22 22)" />
                  <path class="flame" d="M22 13c.9 3 4.5 4.8 4.5 9a4.5 4.5 0 0 1-9 0c0-2 1-3.4 2-4.3.1 1.5.8 2.4 1.7 2.6C21.2 18 21.5 15.3 22 13Z" fill="var(--molten)" />
                </svg>
              </div>
            </div>
            {(['faith', 'general'] as const).map((view) => (
              <ul class="rows" data-only={view}>
                {s.phone[view].map((r) => (
                  <li class={`row ${r.state}`} style={`--c: var(--${['fajr','dhuhr','asr','maghrib','isha'].includes(r.c) ? r.c : 'c-' + r.c})`}>
                    <span class="row-ico" aria-hidden="true"></span>
                    <span class="row-t"><b>{r.t}</b><small>{r.s}</small></span>
                    <span class="row-tick" aria-hidden="true">{r.state === 'done' ? '✓' : ''}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
        <div class="view-switch">
          <span class="vs-label" id="vs-label">{s.switch.label}</span>
          <button type="button" role="switch" id="view-switch" aria-checked="true" aria-labelledby="vs-label">
            <span data-k="faith">{s.switch.faith}</span><span data-k="general">{s.switch.general}</span>
          </button>
          <p class="vs-note" aria-live="polite"><span data-only="faith">{s.switch.faithNote}</span><span data-only="general">{s.switch.generalNote}</span></p>
        </div>
      </div>
    </div>
  </section>

  <section id="season" class="season" aria-labelledby="season-h">
    <div class="wrap season-grid reveal">
      <div>
        <p class="eyebrow" data-only="faith">{s.season.eyebrow}</p>
        <h2 id="season-h" class="section-title"><span data-only="faith">{s.season.faithTitle}</span><span data-only="general">{s.season.generalTitle}</span></h2>
        <p class="section-lead"><span data-only="faith">{s.season.faithText}</span><span data-only="general">{s.season.generalText}</span></p>
      </div>
      <div class="season-card">
        <div class="count" data-only="faith">
          <span class="count-n" id="ramadan-days" data-start={site.ramadanStart} data-lang={lang}>{days}</span>
          <span class="count-l">{s.season.daysTo}</span>
          <small>{s.season.moon}</small>
        </div>
        <svg class="stepdown" viewBox="0 0 320 140" role="img" aria-label="">
          <g class="steps" fill="var(--ember)">
            {[100, 88, 76, 64, 52, 40, 28].map((h, i) => <rect x={8 + i * 44} y={130 - h} width="32" height={h} rx="6" opacity={1 - i * 0.08} style={`--i:${i}`} />)}
          </g>
          <line x1="0" y1="131" x2="320" y2="131" stroke="var(--line)" stroke-width="2" />
          <circle cx="306" cy="129" r="7" fill="var(--molten)" />
        </svg>
      </div>
    </div>
  </section>

  <section id="pillars" class="pillars" aria-labelledby="pillars-h">
    <div class="wrap">
      <h2 id="pillars-h" class="section-title reveal">{s.pillars.title}</h2>
      <div class="pgrid">
        {s.pillars.items.map((it: any) => (
          <article class={`pcard pc-${it.k} reveal`} data-only={it.faithOnly ? 'faith' : it.generalOnly ? 'general' : undefined}>
            <div class="pc-head">
              <svg class="pc-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[it.k]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {it.chip && <span class="chip">{it.chip}</span>}
            </div>
            <h3>{it.name}</h3>
            {it.line && <p class="pc-line">{it.line}</p>}
            {it.lineFaith && <p class="pc-line"><span data-only="faith">{it.lineFaith}</span><span data-only="general">{it.lineGeneral}</span></p>}
            {it.b && <ul>{it.b.map((b: string) => <li>{b}</li>)}</ul>}
            {it.bFaith && <ul data-only="faith">{it.bFaith.map((b: string) => <li>{b}</li>)}</ul>}
            {it.bGeneral && <ul data-only="general">{it.bGeneral.map((b: string) => <li>{b}</li>)}</ul>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="privacy" aria-labelledby="privacy-h">
    <div class="wrap">
      <h2 id="privacy-h" class="section-title reveal">{s.privacy.title}</h2>
      <div class="tiles">
        {s.privacy.tiles.map((x) => <div class="tile reveal"><h3>{x.h}</h3><p>{x.p}</p></div>)}
      </div>
      <p class="priv-line">{s.privacy.line}</p>
      <p class="works"><span>{s.works.title}</span>{s.works.items.map((w) => <span class="chip">{w}</span>)}</p>
    </div>
  </section>

  <section id="pricing" class="pricing" aria-labelledby="pricing-h">
    <div class="wrap">
      <h2 id="pricing-h" class="section-title reveal">{s.pricing.title}</h2>
      <div class="plans">
        <div class="plan reveal">
          <h3>{s.pricing.free}</h3>
          <p class="price">$0</p>
          <ul>{s.pricing.freeItems.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="plan plan-pro reveal">
          <h3>{s.pricing.premium}</h3>
          <dl class="prices">
            <div><dt>{s.pricing.yearly}</dt><dd>{money(pricing.founders.yearly)}</dd></div>
            <div><dt>{s.pricing.lifetime}</dt><dd>{money(pricing.founders.lifetime)}</dd></div>
            <div><dt>{s.pricing.monthly}</dt><dd>{money(pricing.founders.monthly)}</dd></div>
          </dl>
          <p class="fine">{s.pricing.trial}</p>
          <ul>{s.pricing.premiumItems.map((x) => <li>{x}</li>)}</ul>
          <p class="fine">{s.pricing.foundersNote} {s.pricing.local}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="made" aria-labelledby="made-h">
    <div class="wrap made-grid reveal">
      <div class="monogram" aria-hidden="true">BH</div>
      <div><h2 id="made-h">{s.made.title}</h2><p>{s.made.p}</p></div>
    </div>
  </section>

  <section id="notify" class="final" aria-labelledby="final-h">
    <div class="wrap final-grid">
      <div>
        <h2 id="final-h" class="section-title">{s.final.title}</h2>
        <p class="section-lead">{s.final.sub}</p>
      </div>
      <WaitlistForm lang={lang} source="home" id="wl-home" />
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px); isolation: isolate; }
  .hero::before { content: ""; position: absolute; inset: 0; background: var(--heat); z-index: -2; opacity: .9; }
  .sparks { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero-copy { display: grid; gap: 22px; min-width: 0; }
  .strike { font-size: clamp(46px, 8.4vw, 104px); font-weight: 760; letter-spacing: -0.035em; line-height: .95; display: flex; flex-wrap: wrap; column-gap: .24em; }
  :lang(ar) .strike { font-size: clamp(42px, 7.4vw, 92px); line-height: 1.25; font-weight: 800; }
  .w { display: inline-block; }
  :root:not([data-motion="off"]) .w { animation: strike 900ms var(--ease-strike) both; animation-delay: calc(240ms + var(--i) * 110ms); }
  @keyframes strike {
    0% { opacity: 0; transform: translateY(.35em) scale(1.04); color: #fff; text-shadow: 0 0 28px var(--ember-glow), 0 0 6px #fff; }
    35% { opacity: 1; transform: none; color: #FFF4E0; text-shadow: 0 0 22px var(--ember-glow); }
    100% { opacity: 1; transform: none; color: var(--text); text-shadow: 0 0 0 transparent; }
  }
  .sub { font-size: clamp(18px, 2vw, 21px); color: var(--text-2); max-width: 46ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-meta b { color: var(--molten); font-variant-numeric: tabular-nums; }
  .strip-wrap { display: grid; gap: 10px; margin-top: 6px; }
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(30, 1fr); gap: 5px; max-width: 520px; }
  .strip li { aspect-ratio: 1; border-radius: 50%; background: var(--iron); opacity: .55; transition: background var(--t-ui), box-shadow var(--t-ui), opacity var(--t-ui); }
  .strip li.lit { background: var(--ember); opacity: 1; box-shadow: 0 0 10px color-mix(in oklab, var(--ember-glow) 70%, transparent); }
  .strip li.lit.today { background: var(--molten); }
  .strip-label { font-size: 13px; color: var(--text-2); }

  .hero-phone { display: grid; justify-items: center; gap: 22px; min-width: 0; }
  .phone { width: min(330px, 100%); aspect-ratio: 9 / 19; border-radius: 48px; padding: 10px; background: linear-gradient(160deg, #3A2E26, #120E0B 60%); box-shadow: 0 40px 80px -30px rgba(0,0,0,.7), 0 0 0 1px color-mix(in oklab, var(--line) 80%, transparent), 0 0 90px -20px color-mix(in oklab, var(--ember) 45%, transparent); }
  :root:not([data-motion="off"]) .phone { animation: rise 1100ms var(--ease-strike) 700ms both; }
  @keyframes rise { from { opacity: 0; transform: translateY(48px) perspective(900px) rotateX(10deg); } to { opacity: 1; transform: none; } }
  .screen { position: relative; height: 100%; border-radius: 39px; background: var(--bg); overflow: hidden; padding: 46px 14px 14px; display: grid; align-content: start; gap: 16px; }
  .notch { position: absolute; top: 10px; left: 50%; translate: -50% 0; width: 92px; height: 26px; border-radius: 20px; background: #000; }
  .ph-top { display: flex; justify-content: space-between; align-items: center; padding-inline: 6px; }
  .ph-day { display: block; font: 700 26px/1.1 var(--f-display); }
  :lang(ar) .ph-day { font-family: var(--f-ar-display); }
  .ph-date { font-size: 12px; color: var(--text-2); }
  .dial { width: 50px; height: 50px; }
  :root:not([data-motion="off"]) .dial-arc { animation: arc 1400ms var(--ease-strike) 1500ms both; }
  @keyframes arc { from { stroke-dasharray: 0 100; } }
  :root:not([data-motion="off"]) .flame { transform-origin: 22px 26px; animation: ignite 700ms var(--ease-strike) 2300ms both; }
  @keyframes ignite { from { opacity: 0; transform: scale(.3); } 60% { opacity: 1; transform: scale(1.18); } to { transform: none; } }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .row { display: grid; grid-template-columns: 34px minmax(0, 1fr) 26px; gap: 10px; align-items: center; background: var(--surface); border-radius: 16px; padding: 10px 12px; }
  .row-ico { width: 34px; height: 34px; border-radius: 11px; background: color-mix(in oklab, var(--c) 22%, transparent); border: 2px solid var(--c); }
  .row-t { display: grid; min-width: 0; }
  .row-t b { font-size: 14px; font-weight: 600; }
  .row-t small { font-size: 11.5px; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row-tick { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 14px; border: 2px solid var(--iron); color: var(--on-ember); }
  .row.done .row-tick { background: var(--c); border-color: var(--c); }
  .row.half .row-tick { border-color: var(--c); background: conic-gradient(var(--c) 0 55%, transparent 0); }
  .row.next .row-tick { border-style: dashed; border-color: var(--c); }
  .view-switch { display: grid; justify-items: center; gap: 8px; text-align: center; }
  .vs-label { font-size: 14px; color: var(--text-2); }
  #view-switch { display: inline-flex; padding: 4px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); cursor: pointer; font: 600 15px var(--f-body); color: var(--text-2); }
  #view-switch span { padding: 8px 18px; border-radius: 999px; transition: background var(--t-ui), color var(--t-ui); }
  #view-switch[aria-checked="true"] [data-k="faith"], #view-switch[aria-checked="false"] [data-k="general"] { background: var(--ember); color: var(--on-ember); }
  .vs-note { font-size: 13px; color: var(--text-2); max-width: 34ch; min-height: 3em; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-phone { order: 2; } }

  .season { background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--surface) 70%, transparent)); border-block: 1px solid var(--line); }
  .season-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 48px; align-items: center; }
  .season-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; display: grid; gap: 22px; }
  .count { display: grid; gap: 2px; }
  .count-n { font: 800 clamp(64px, 9vw, 104px)/1 var(--f-display); color: var(--ember-text); font-variant-numeric: tabular-nums; letter-spacing: -0.04em; }
  .count-l { font-size: 18px; }
  .count small { color: var(--text-2); font-size: 13px; }
  .stepdown { width: 100%; height: auto; }
  @media (max-width: 860px) { .season-grid { grid-template-columns: 1fr; } }

  .pgrid { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .pcard { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; display: grid; gap: 12px; align-content: start; transition: border-color var(--t-ui), transform var(--t-ui) var(--ease-strike); }
  .pcard:hover { border-color: color-mix(in oklab, var(--ember) 60%, var(--line)); transform: translateY(-3px); }
  .pc-head { display: flex; justify-content: space-between; align-items: center; }
  .pc-ico { width: 30px; height: 30px; color: var(--ember-text); }
  .pcard h3 { font-size: 24px; }
  .pc-line { color: var(--text-2); }
  .pcard ul { margin: 6px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 15.5px; }
  .pcard li { display: grid; grid-template-columns: 14px 1fr; gap: 10px; }
  .pcard li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--ember); margin-top: .62em; box-shadow: 0 0 8px var(--ember-glow); }

  .tiles { margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .tile { border-top: 2px solid var(--ember); padding-top: 18px; display: grid; gap: 8px; }
  .tile h3 { font-size: 21px; }
  .tile p { color: var(--text-2); }
  .priv-line { margin-top: 40px; font: 700 clamp(22px, 3vw, 30px)/1.2 var(--f-display); color: var(--molten); }
  :lang(ar) .priv-line { font-family: var(--f-ar-display); }
  .works { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--text-2); }
  .works > span:first-child { margin-inline-end: 6px; }

  .plans { margin-top: 44px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .plan { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; display: grid; gap: 14px; align-content: start; }
  .plan-pro { border-color: color-mix(in oklab, var(--ember) 55%, var(--line)); background: linear-gradient(170deg, color-mix(in oklab, var(--ember) 10%, var(--surface)), var(--surface) 60%); }
  .plan h3 { font-size: 24px; }
  .price { font: 800 44px/1 var(--f-display); }
  .prices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; }
  .prices div { background: var(--surface-2); border-radius: 14px; padding: 12px; }
  .prices dt { font-size: 13px; color: var(--text-2); }
  .prices dd { margin: 4px 0 0; font: 700 22px/1 var(--f-display); font-variant-numeric: tabular-nums; }
  .plan ul { margin: 0; padding-inline-start: 18px; display: grid; gap: 6px; }
  .fine { font-size: 13px; color: var(--text-2); }

  .made-grid { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 28px; align-items: center; max-width: 820px; }
  .monogram { width: 88px; height: 88px; border-radius: 50%; display: grid; place-items: center; font: 800 30px var(--f-display); color: var(--on-ember); background: radial-gradient(circle at 50% 70%, var(--ember), var(--molten)); }
  .made h2 { font-size: clamp(26px, 3.4vw, 36px); margin-bottom: 10px; }
  .made p { color: var(--text-2); max-width: 60ch; }

  .final { position: relative; overflow: hidden; isolation: isolate; }
  .final::before { content: ""; position: absolute; inset: 0; background: var(--heat); opacity: .55; z-index: -1; }
  .final-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: end; }
  @media (max-width: 860px) { .final-grid, .made-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const root = document.documentElement;
  const motionOn = () => root.getAttribute('data-motion') !== 'off';

  // Faith / General switch
  const sw = document.getElementById('view-switch')!;
  const paintView = () => sw.setAttribute('aria-checked', String(root.getAttribute('data-view') !== 'general'));
  sw.addEventListener('click', () => {
    const next = root.getAttribute('data-view') === 'general' ? 'faith' : 'general';
    const apply = () => { root.setAttribute('data-view', next); paintView(); };
    // @ts-ignore
    if (motionOn() && document.startViewTransition) document.startViewTransition(apply); else apply();
    try { localStorage.setItem('forge-view', next); } catch {}
  });
  paintView();

  // Ramadan countdown, live in the visitor's time zone
  const cd = document.getElementById('ramadan-days');
  if (cd) {
    const n = Math.max(0, Math.ceil((Date.parse(cd.dataset.start + 'T00:00:00') - Date.now()) / 864e5));
    cd.textContent = new Intl.NumberFormat(cd.dataset.lang === 'ar' ? 'ar' : cd.dataset.lang).format(n);
  }

  // Thirty embers: a week lights on load, the rest with scroll
  const dots = Array.from(document.querySelectorAll<HTMLLIElement>('.strip li'));
  let base = 0;
  const light = (n: number) => dots.forEach((d, i) => { d.classList.toggle('lit', i < n); d.classList.toggle('today', i === n - 1); });
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    const extra = max > 0 ? Math.round((scrollY / max) * (30 - base)) : 0;
    light(Math.min(30, base + extra));
  };
  if (motionOn()) {
    let k = 0; const step = () => { base = ++k; light(k); if (k < 7) setTimeout(step, 120); };
    setTimeout(step, 1300);
  } else { base = 7; light(7); }
  addEventListener('scroll', onScroll, { passive: true });

  // Sparks: a light 2D canvas; off for reduced motion and when the hero is off-screen
  const cv = document.querySelector<HTMLCanvasElement>('.sparks')!;
  const ctx = cv.getContext('2d');
  let raf = 0, visible = true, w = 0, h = 0;
  const dpr = Math.min(1.5, devicePixelRatio || 1);
  type P = { x: number; y: number; vx: number; vy: number; life: number; max: number; r: number };
  let ps: P[] = [];
  const size = () => { w = cv.clientWidth; h = cv.clientHeight; cv.width = w * dpr; cv.height = h * dpr; ctx?.setTransform(dpr, 0, 0, dpr, 0, 0); };
  const spawn = (): P => ({ x: Math.random() * w, y: h + 10, vx: (Math.random() - .5) * .35, vy: -(.5 + Math.random() * 1.3), life: 0, max: 240 + Math.random() * 320, r: .6 + Math.random() * 1.9 });
  const count = () => Math.round(Math.min(140, w / 9));
  const tick = () => {
    if (!ctx) return;
    ctx.clearRect(0, 0, w, h);
    while (ps.length < count()) ps.push(spawn());
    ctx.globalCompositeOperation = 'lighter';
    for (const p of ps) {
      p.life++; p.x += p.vx + Math.sin((p.y + p.life) * .012) * .3; p.y += p.vy;
      const k = p.life / p.max;
      const a = Math.max(0, 1 - k) * .9;
      const hue = 28 + k * 20;
      ctx.fillStyle = `hsla(${hue}, 100%, ${62 - k * 22}%, ${a})`;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (1 - k * .5), 0, 6.283); ctx.fill();
    }
    ps = ps.filter((p) => p.life < p.max && p.y > -10);
    raf = requestAnimationFrame(tick);
  };
  const run = () => { cancelAnimationFrame(raf); if (motionOn() && visible && !document.hidden) raf = requestAnimationFrame(tick); else ctx?.clearRect(0, 0, w, h); };
  size(); addEventListener('resize', () => { size(); });
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; run(); }).observe(cv);
  document.addEventListener('visibilitychange', run);
  document.addEventListener('forge:motion', run);
  run();
</script>
