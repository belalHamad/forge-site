---
import Base from '../layouts/Base.astro';
import WaitlistForm from './WaitlistForm.astro';
import { t, type Lang } from '../lib/i18n';
import site from '../data/site.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<Base lang={lang} title={s.meta.androidTitle} description={s.meta.androidDescription} path="/android/">
  <section class="and">
    <div class="wrap and-grid">
      <div class="and-copy">
        <p class="eyebrow">Android</p>
        <h1>{s.android.h1}</h1>
        <p class="lead">{s.android.p}</p>
        <ul class="and-chips">{s.android.chips.map((c) => <li class="chip">{c}</li>)}</ul>
        {site.androidState === 'live' && site.playUrl
          ? <a class="btn btn-ember" href={site.playUrl}>Google Play</a>
          : <WaitlistForm lang={lang} source="android" id="wl-android" />}
        <p class="later">{s.android.later}</p>
      </div>
      <div class="embers" aria-hidden="true">
        {Array.from({ length: 30 }, (_, i) => <span style={`--i:${i}`}></span>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .and { position: relative; isolation: isolate; overflow: hidden; }
  .and::before { content: ""; position: absolute; inset: 0; background: var(--heat); opacity: .7; z-index: -1; }
  .and-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: 48px; align-items: center; }
  .and-copy { display: grid; gap: 20px; }
  .and h1 { font-size: clamp(40px, 6.5vw, 76px); }
  .lead { font-size: 19px; color: var(--text-2); max-width: 52ch; }
  .and-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .later { font-size: 14px; color: var(--text-2); max-width: 56ch; }
  .embers { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; max-width: 300px; justify-self: center; }
  .embers span { aspect-ratio: 1; border-radius: 50%; background: var(--iron); opacity: .5; }
  :root:not([data-motion="off"]) .embers span { animation: glow 3.6s var(--ease-cool) infinite; animation-delay: calc(var(--i) * 120ms); }
  @keyframes glow { 0%, 60%, 100% { background: var(--iron); opacity: .5; box-shadow: none; } 20% { background: var(--ember); opacity: 1; box-shadow: 0 0 16px var(--ember-glow); } }
  @media (max-width: 820px) { .and-grid { grid-template-columns: 1fr; } .embers { display: none; } }
</style>
